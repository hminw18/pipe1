# Pipe1 desktop client runtime config.
# Copy this file to config/pipe1.client.env for local production-style runs,
# or set PIPE1_CLIENT_ENV_FILE to an absolute env file path.

PIPE1_APP_ENV=dev
PIPE1_APP_VERSION=0.1.2
PIPE1_LICENSE_API_BASE_URL=
PIPE1_LICENSE_PUBLIC_KEYS={}

# Optional overrides.
# PIPE1_REQUIRE_LICENSE_ACTIVATION=false
# PIPE1_LICENSE_STATE_DIR=
# PIPE1_UPDATE_CHECK_ENABLED=false
# PIPE1_UPDATE_CHANNEL=stable
# PIPE1_UPDATE_PLATFORM=windows
# PIPE1_UPDATE_ARCH=x64
