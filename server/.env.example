# Copy to .env for local development against compose.yaml.
PIPE1_DATABASE_URL=postgresql+psycopg://pipe1_app:pipe1_app@localhost:5432/pipe1
PIPE1_MIGRATION_DATABASE_URL=postgresql+psycopg://pipe1_migrator:pipe1_migrator@localhost:5432/pipe1
# Superuser connection used by the test suite to create throwaway databases.
PIPE1_TEST_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
